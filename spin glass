def apply_layers(qc, source, sink, layers, param, init_st=None, add_barrier=True):
    t = ParameterVector('t', param)

    # Set i based on whether init_st is provided
    if init_st is not None:
        i = init_st.num_parameters
    else:
        i = 0  # If init_st is not provided, set i to 0

    for _ in range(layers):
        if add_barrier:
            qc.barrier()

        # Append the source instructions
        for idx, (q1, q2) in enumerate(source):
            qc.append(two_q_cluster.to_instruction({p[0]: t[i + idx]}), [qr[q1], qr[q2]])

        i += len(source)  # Update i after the source layer

        if add_barrier:
            qc.barrier()

        # Append the sink instructions
        for idx, (q1, q2) in enumerate(sink):
            qc.append(two_q_cluster.to_instruction({p[0]: t[i + idx]}), [qr[q1], qr[q2]])

        i += len(sink)  # Update i after the sink layer

    # Transpile the circuit
    qc = transpile(qc, basis_gates=['u', 'cx'])

    # Output circuit information
    print("\n============********===============")
    print("Transpile Depth =", qc.depth())
    print(qc.count_ops())
    print("\nNumber of parameters: ", qc.num_parameters)
    print("\n============********===============")


