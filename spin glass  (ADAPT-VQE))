        else:
            print("No two-qubit operators above threshold this iteration.")

        # Step 2: Select and add single-qubit operators
        state = state_from_ops_thetas(combined_ops, combined_thetas, n_qubits)
        selected_single_qubit = filter_operators_by_gradient(state, hamiltonian, single_qubit_ops, gradient_threshold=gradient_threshold)
