            selected_single_qubit_ops = [op for (op, idx, g) in selected_single_qubit]
            selected_single_qubit_info = [idx for (op, idx, g) in selected_single_qubit]
            combined_ops.extend(selected_single_qubit_ops)
            combined_info.extend(selected_single_qubit_info)

            new_angles = cp.array([cp.random.uniform(-cp.pi, cp.pi) for _ in selected_single_qubit_ops], dtype=float)
            if combined_thetas.size == 0:
                initial_thetas = new_angles
            else:
                # Ensure both arrays are CuPy explicitly
                initial_thetas = cp.concatenate([cp.asarray(combined_thetas), cp.asarray(new_angles)])

            # Perform GPU-based optimization
            combined_thetas = perform_gpu_optimization(combined_ops, hamiltonian, n_qubits, initial_thetas)

            state = state_from_ops_thetas(combined_ops, combined_thetas, n_qubits)
            energy = energy_expectation(state, hamiltonian)
            fidelity = abs(cp.vdot(state, exact_ground_state))**2
            print(f"After single-qubit selection optimization:")
            print(f"Energy: {energy:.5f}, Fidelity: {fidelity:.3f}, Energy error: {abs(energy - exact_ground_state_energy):.5f}")
        else:
            print("No single-qubit operators above threshold this iteration.")

        # Final circuit using parameters from two- and single-qubit optimizations
        qc_final = QuantumCircuit(n_qubits)
        build_circuit(qc_final, combined_info, cp.asnumpy(combined_thetas))  # Use all operators and their optimized parameters
        print("\nFinal circuit after single- and two-qubit optimizations:")
        display(qc_final.draw('mpl'))

        # Compute final energy using the frozen parameters
        state = state_from_ops_thetas(combined_ops, combined_thetas, n_qubits)
        energy = energy_expectation(state, hamiltonian)
        fidelity = abs(cp.vdot(state, exact_ground_state))**2
        print(f"Final energy: {energy:.5f}")
        print(f"Final fidelity: {fidelity:.3f}, Energy error: {abs(energy - exact_ground_state_energy):.5f}")


        # Build and display circuit
        #qc = QuantumCircuit(n_qubits)
        #build_circuit(qc, combined_info, cp.asnumpy(combined_thetas))  # Use NumPy for circuit angles
        #display(qc.draw('mpl'))
        ansatz = transpile(qc_final, basis_gates=['u', 'cx'])
        print("Transpile Depth =", ansatz.depth())
        print(ansatz.count_ops())
        print("\n============********===============")
        # Count single- and two-qubit gate parameters
        single_qubit_params = 0
        two_qubit_params = 0
        
        for gate, qargs, _ in qc_final.data:
            if len(qargs) == 1:  # Single-qubit gate
                single_qubit_params += len(gate.params)
            elif len(qargs) == 2:  # Two-qubit gate
                two_qubit_params += len(gate.params)

        # Print the results
        print(f"Total single-qubit gate parameters: {single_qubit_params}")
        print(f"Total two-qubit gate parameters: {two_qubit_params}")
        # Check convergence
        if abs(energy - prev_energy) < convergence_tol:
            print(f"Converged at iteration {iteration}, energy: {energy:.5f}")
            break

        # Stop if no new operators are added
        if len(selected_two_qubit) == 0 and len(selected_single_qubit) == 0:
            print("No new operators added and no improvement, stopping.")
            break

        prev_energy = energy

    end_time = time.time()
    print(f"Total running time: {end_time - start_time:.4f} seconds")



