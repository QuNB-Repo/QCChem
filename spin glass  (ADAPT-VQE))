    exact_ground_state = cp.array(eigenvectors[:, np.argmin(eigenvalues)], dtype=complex)

    # Build operator pools
    single_qubit_ops, two_qubit_ops = build_operator_pool(weighted_edge_list, n_qubits)

    # Initialize ansatz
    combined_ops = []
