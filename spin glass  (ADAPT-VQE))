            if combined_thetas.size == 0:
                initial_thetas = new_angles
            else:
                # Ensure both arrays are CuPy explicitly
                initial_thetas = cp.concatenate([cp.asarray(combined_thetas), cp.asarray(new_angles)])

            # Perform GPU-based optimization
            combined_thetas = perform_gpu_optimization(combined_ops, hamiltonian, n_qubits, initial_thetas)

            state = state_from_ops_thetas(combined_ops, combined_thetas, n_qubits)
