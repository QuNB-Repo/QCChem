import time
# Pauli matrices
I_matrix = np.array([[1, 0],
                     [0, 1]], dtype=complex)
X_matrix = np.array([[0, 1],
                     [1, 0]], dtype=complex)
Y_matrix = np.array([[0, -1j],
                     [1j, 0]], dtype=complex)
Z_matrix = np.array([[1, 0],
                     [0,-1]], dtype=complex)

def tensor_product(*ops):
    result = np.array([[1]], dtype=complex)
    for op in ops:
        result = np.kron(result, op)
    return result

def build_hamiltonian_matrix(weighted_edge_list, n_qubits, coeff_zz=1.0, coeff_x=1.0):
    hamiltonian = np.zeros((2**n_qubits, 2**n_qubits), dtype=complex)
    # ZZ terms
    for (i, j, weight) in weighted_edge_list:
        zz_term = coeff_zz * weight * tensor_product(*[Z_matrix if (k==i or k==j) else I_matrix for k in range(n_qubits)])
        hamiltonian += zz_term
    # X terms
    for i in range(n_qubits):
        x_term = coeff_x * tensor_product(*[X_matrix if k==i else I_matrix for k in range(n_qubits)])
        hamiltonian += x_term
    return hamiltonian

def initial_state(n_qubits):
    state = np.zeros(2**n_qubits, dtype=complex)
    state[0] = 1.0
    return state

def apply_unitary(state, operator, theta):
    U = expm(-1j * theta * operator)
    return U @ state

def energy_expectation(state, hamiltonian):
    return np.real(np.vdot(state, hamiltonian @ state))

def vqe_optimization(thetas, operators, initial, hamiltonian):
    state = initial
    for theta, op in zip(thetas, operators):
        state = apply_unitary(state, op, theta)
    return energy_expectation(state, hamiltonian)

def finite_difference_gradient(state, hamiltonian, operator, delta=1e-4):
    state_plus = apply_unitary(state, operator, +delta)
    E_plus = energy_expectation(state_plus, hamiltonian)

    state_minus = apply_unitary(state, operator, -delta)
    E_minus = energy_expectation(state_minus, hamiltonian)

    return (E_plus - E_minus) / (2 * delta)

def perform_vqe_optimization(selected_ops, hamiltonian, n_qubits, initial_thetas=None):
    if initial_thetas is None:
        initial_thetas = [np.random.uniform(-np.pi, np.pi) for _ in selected_ops]

    initial_thetas = np.array(initial_thetas, dtype=float)  # Ensure NumPy array
    result = minimize(
        vqe_optimization,
        initial_thetas,
        args=([o for o in selected_ops], initial_state(n_qubits), hamiltonian),
        method='SLSQP',
        options={'maxiter':1000, 'ftol':1e-12}
    )
    return result.x

def build_operator_pool(weighted_edge_list, n_qubits):
    paulis = ['X','Y','Z']
    single_qubit_ops = []
    for i in range(n_qubits):
        single_qubit_ops.append((tensor_product(*[X_matrix if k==i else I_matrix for k in range(n_qubits)]), (i, 'X')))
        single_qubit_ops.append((tensor_product(*[Y_matrix if k==i else I_matrix for k in range(n_qubits)]), (i, 'Y')))
        single_qubit_ops.append((tensor_product(*[Z_matrix if k==i else I_matrix for k in range(n_qubits)]), (i, 'Z')))

    two_qubit_ops = []
    for (u, v, _) in weighted_edge_list:
        i, j = (u, v) if u < v else (v, u)
        for A in paulis:
            for B in paulis:
                op = []
                for k in range(n_qubits):
                    if k == i:
                        op.append(X_matrix if A=='X' else Y_matrix if A=='Y' else Z_matrix)
                    elif k == j:
                        op.append(X_matrix if B=='X' else Y_matrix if B=='Y' else Z_matrix)
                    else:
                        op.append(I_matrix)
                two_qubit_ops.append((tensor_product(*op), (i, j, A+B)))
    return single_qubit_ops, two_qubit_ops

def filter_operators_by_gradient(state, hamiltonian, operators, gradient_threshold=1e-5, delta=1e-4):
    filtered_ops = []
    for op, idx in operators:
        g = finite_difference_gradient(state, hamiltonian, op, delta=delta)
        if abs(g) > gradient_threshold:
            filtered_ops.append((op, idx, g))
    return filtered_ops

def forward_transform(qc, qubit, p):
    if p == 'X':
        qc.h(qubit)
    elif p == 'Y':
        qc.sdg(qubit)
        qc.h(qubit)

def backward_transform(qc, qubit, p):
    if p == 'X':
        qc.h(qubit)
    elif p == 'Y':
        qc.h(qubit)
        qc.s(qubit)

def apply_two_qubit_rotation(qc, A, B, i, j, theta):
    forward_transform(qc, i, A)
    forward_transform(qc, j, B)
    qc.cx(i, j)
    qc.rz(2*theta, j)
    qc.cx(i, j)
    backward_transform(qc, j, B)
    backward_transform(qc, i, A)

def build_circuit(qc, ops_info, thetas):
    # Build circuit from ops and thetas
    for theta, op_info in zip(thetas, ops_info):
        if len(op_info) == 2:
            q, P = op_info
            if P == 'X':
                qc.rx(2*theta, q)
            elif P == 'Y':
                qc.ry(2*theta, q)
            elif P == 'Z':
                qc.rz(2*theta, q)
        elif len(op_info) == 3:
            i, j, AB = op_info
            A, B = AB[0], AB[1]
            apply_two_qubit_rotation(qc, A, B, i, j, theta)

def state_from_ops_thetas(ops, thetas, n_qubits):
    st = initial_state(n_qubits)
    for theta, op in zip(thetas, ops):
        st = apply_unitary(st, op, theta)
    return st

def run_vqe_with_iterations(weighted_edge_list, n_qubits, coeff_zz, coeff_x, gradient_threshold=1e-5, convergence_tol=1e-7):
    start_time = time.time()
    hamiltonian = build_hamiltonian_matrix(weighted_edge_list, n_qubits, coeff_zz, coeff_x)
    eigenvalues, eigenvectors = eigh(hamiltonian)
    exact_ground_state_energy = np.min(eigenvalues)
    exact_ground_state = eigenvectors[:, np.argmin(eigenvalues)]

    single_qubit_ops, two_qubit_ops = build_operator_pool(weighted_edge_list, n_qubits)

    # Start with empty ansatz
    combined_ops = []
    combined_info = []
    combined_thetas = np.array([], dtype=float)

    prev_energy = np.inf
    iteration = 0

    while True:
        iteration += 1
        print(f"\n--- Iteration {iteration} ---")

        # Compute current state
        state = state_from_ops_thetas(combined_ops, combined_thetas, n_qubits)

        # Step 1: Select and add two-qubit operators
        selected_two_qubit = filter_operators_by_gradient(state, hamiltonian, two_qubit_ops, gradient_threshold=gradient_threshold)
        if len(selected_two_qubit) > 0:
            print("Selected two-qubit operators:")
            for (op, idx, g) in selected_two_qubit:
                print(f"  Operator {idx}, gradient: {g:.6f}")

            selected_two_qubit_ops = [op for (op, idx, g) in selected_two_qubit]
            selected_two_qubit_info = [idx for (op, idx, g) in selected_two_qubit]
            combined_ops.extend(selected_two_qubit_ops)
            combined_info.extend(selected_two_qubit_info)

            new_angles = np.array([np.random.uniform(-np.pi, np.pi) for _ in selected_two_qubit_ops], dtype=float)
            if combined_thetas.size == 0:
                initial_thetas = new_angles
            else:
                initial_thetas = np.concatenate([combined_thetas, new_angles])

            combined_thetas = perform_vqe_optimization(combined_ops, hamiltonian, n_qubits, initial_thetas)

            state = state_from_ops_thetas(combined_ops, combined_thetas, n_qubits)
            energy = energy_expectation(state, hamiltonian)
            fidelity = abs(np.vdot(state, exact_ground_state))**2
            print(f"After two-qubit selection optimization:")
            print(f"Energy: {energy:.5f}, Fidelity: {fidelity:.3f}, Energy error: {abs(energy - exact_ground_state_energy):.5f}")
        else:
            print("No two-qubit operators above threshold this iteration.")

        # Step 2: Select and add single-qubit operators
        state = state_from_ops_thetas(combined_ops, combined_thetas, n_qubits)
        selected_single_qubit = filter_operators_by_gradient(state, hamiltonian, single_qubit_ops, gradient_threshold=gradient_threshold)
        if len(selected_single_qubit) > 0:
            print("Selected single-qubit operators:")
            for (op, idx, g) in selected_single_qubit:
                print(f"  Operator {idx}, gradient: {g:.6f}")

            selected_single_qubit_ops = [op for (op, idx, g) in selected_single_qubit]
            selected_single_qubit_info = [idx for (op, idx, g) in selected_single_qubit]
            combined_ops.extend(selected_single_qubit_ops)
            combined_info.extend(selected_single_qubit_info)

            new_angles = np.array([np.random.uniform(-np.pi, np.pi) for _ in selected_single_qubit_ops], dtype=float)
            if combined_thetas.size == 0:
                initial_thetas = new_angles
            else:
                initial_thetas = np.concatenate([combined_thetas, new_angles])

            combined_thetas = perform_vqe_optimization(combined_ops, hamiltonian, n_qubits, initial_thetas)

            state = state_from_ops_thetas(combined_ops, combined_thetas, n_qubits)
            energy = energy_expectation(state, hamiltonian)
            fidelity = abs(np.vdot(state, exact_ground_state))**2
            print(f"After single-qubit selection optimization:")
            print(f"Energy: {energy:.5f}, Fidelity: {fidelity:.3f}, Energy error: {abs(energy - exact_ground_state_energy):.5f}")
        else:
            print("No single-qubit operators above threshold this iteration.")

        # Step 3: Final refinement
        combined_thetas = perform_vqe_optimization(combined_ops, hamiltonian, n_qubits, combined_thetas)
        state = state_from_ops_thetas(combined_ops, combined_thetas, n_qubits)
        energy = energy_expectation(state, hamiltonian)
        fidelity = abs(np.vdot(state, exact_ground_state))**2
        print("Final optimization with all selected operators:")
        print(f"Energy: {energy:.5f}, Fidelity: {fidelity:.3f}, Energy error: {abs(energy - exact_ground_state_energy):.5f}")

        qc = QuantumCircuit(n_qubits)
        build_circuit(qc, combined_info, combined_thetas)
        display(qc.draw('mpl'))
        anstaz = transpile(qc, basis_gates=['u', 'cx'])
        print("Transpile Depth =", anstaz.depth())
        print(anstaz.count_ops())
        print("\n============********===============")

        # Check convergence
        if abs(energy - prev_energy) < convergence_tol:
            print(f"Converged at iteration {iteration}, energy: {energy:.5f}")
            break

        # If no operators were added this iteration, no improvement
        if len(selected_two_qubit) == 0 and len(selected_single_qubit) == 0:
            print("No new operators added and no improvement, stopping.")
            break

        prev_energy = energy
    end_time = time.time()
    print(f"Total running time: {end_time - start_time:.4f} seconds")
