        # Compute current state
        state = state_from_ops_thetas(combined_ops, combined_thetas, n_qubits)

        # Step 1: Select and add two-qubit operators
        selected_two_qubit = filter_operators_by_gradient(state, hamiltonian, two_qubit_ops, gradient_threshold=gradient_threshold)
