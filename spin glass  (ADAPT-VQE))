import torch
import numpy as np

import torch
import numpy as np

def vqe_loss(thetas, selected_ops, hamiltonian, n_qubits, device="cuda"):
    """
    Computes the VQE loss (energy expectation value).
    """
    # Initialize |0...0> state
    state = torch.zeros(2**n_qubits, dtype=torch.complex64, device=device)
    state[0] = 1.0  

    # Apply the unitary operators sequentially
    for theta, op in zip(thetas, selected_ops):
        operator_torch = torch.as_tensor(op, dtype=torch.complex64, device=device)
        U = torch.matrix_exp(-1j * theta * operator_torch)
        state = torch.matmul(U, state)

    # Compute energy expectation value
    hamiltonian_torch = torch.as_tensor(hamiltonian, dtype=torch.complex64, device=device)
    energy = torch.real(torch.vdot(state, torch.matmul(hamiltonian_torch, state)))
    return energy

def perform_gpu_optimization(selected_ops, hamiltonian, n_qubits, 
                                    initial_thetas=None, pretrain_steps=100, 
                                    adam_lr=0.01, lbfgs_lr=0.1, max_lbfgs_iter=50, 
                                    device="cuda"):
    """
    Hybrid optimization: Pre-train with Adam, then fine-tune with LBFGS.
    """
    if initial_thetas is None:
        initial_thetas = np.random.uniform(-np.pi, np.pi, len(selected_ops))

    # Initialize parameters
    thetas = torch.tensor(initial_thetas, requires_grad=True, dtype=torch.float32, device=device)

    # Step 1: Pre-train with Adam
    print("Starting Adam pre-training...")
    optimizer_adam = torch.optim.Adam([thetas], lr=adam_lr)

    for step in range(pretrain_steps):
        optimizer_adam.zero_grad()
        loss = vqe_loss(thetas, selected_ops, hamiltonian, n_qubits, device=device)
        loss.backward()
        optimizer_adam.step()

        if step % 10 == 0:
            print(f"Adam Step {step + 1}, Loss: {loss.item()}")

    # Step 2: Fine-tune with LBFGS
    print("Switching to LBFGS fine-tuning...")
    optimizer_lbfgs = torch.optim.LBFGS([thetas], lr=lbfgs_lr, history_size=10, max_iter=20)

    # Define the closure for LBFGS
    def closure():
        optimizer_lbfgs.zero_grad()
        loss = vqe_loss(thetas, selected_ops, hamiltonian, n_qubits, device=device)
        loss.backward()
        return loss

    for step in range(max_lbfgs_iter):
        loss = optimizer_lbfgs.step(closure)

        if step % 5 == 0:
            print(f"LBFGS Step {step + 1}, Loss: {loss.item()}")

        # Convergence check
        if torch.norm(thetas.grad) < 1e-5:
            print(f"Converged at LBFGS step {step + 1} with Loss: {loss.item()}")
            break

    return thetas.detach().cpu().numpy()


def build_operator_pool(weighted_edge_list, n_qubits):
    paulis = ['X', 'Y', 'Z']
    single_qubit_ops = []
    for i in range(n_qubits):
        single_qubit_ops.append((tensor_product(*[X_matrix if k == i else I_matrix for k in range(n_qubits)]), (i, 'X')))
        single_qubit_ops.append((tensor_product(*[Y_matrix if k == i else I_matrix for k in range(n_qubits)]), (i, 'Y')))
        single_qubit_ops.append((tensor_product(*[Z_matrix if k == i else I_matrix for k in range(n_qubits)]), (i, 'Z')))

    two_qubit_ops = []
    for (u, v, _) in weighted_edge_list:
        i, j = (u, v) if u < v else (v, u)
        for A in paulis:
            for B in paulis:
                op = []
                for k in range(n_qubits):
                    if k == i:
                        op.append(X_matrix if A == 'X' else Y_matrix if A == 'Y' else Z_matrix)
                    elif k == j:
                        op.append(X_matrix if B == 'X' else Y_matrix if B == 'Y' else Z_matrix)
                    else:
                        op.append(I_matrix)
                two_qubit_ops.append((tensor_product(*op), (i, j, A+B)))
    return single_qubit_ops, two_qubit_ops

def filter_operators_by_gradient(state, hamiltonian, operators, gradient_threshold=1e-5, delta=1e-4):
    filtered_ops = []
    for op, idx in operators:
        g = finite_difference_gradient(state, hamiltonian, op, delta=delta)
        if abs(g) > gradient_threshold:
            filtered_ops.append((op, idx, g))
    return filtered_ops

def forward_transform(qc, qubit, p):
    if p == 'X':
        qc.h(qubit)
    elif p == 'Y':
        qc.sdg(qubit)
        qc.h(qubit)

def backward_transform(qc, qubit, p):
    if p == 'X':
        qc.h(qubit)
    elif p == 'Y':
        qc.h(qubit)
        qc.s(qubit)

def apply_two_qubit_rotation(qc, A, B, i, j, theta):
    forward_transform(qc, i, A)
    forward_transform(qc, j, B)
    qc.cx(i, j)
    qc.rz(2 * theta, j)
    qc.cx(i, j)
    backward_transform(qc, j, B)
    backward_transform(qc, i, A)

def build_circuit(qc, ops_info, thetas):
    for theta, op_info in zip(thetas, ops_info):
        if len(op_info) == 2:
            q, P = op_info
            if P == 'X':
                qc.rx(2 * theta, q)
            elif P == 'Y':
                qc.ry(2 * theta, q)
            elif P == 'Z':
                qc.rz(2 * theta, q)
        elif len(op_info) == 3:
            i, j, AB = op_info
            A, B = AB[0], AB[1]
            apply_two_qubit_rotation(qc, A, B, i, j, theta)

def state_from_ops_thetas(ops, thetas, n_qubits):
    state = initial_state(n_qubits)
    for theta, op in zip(thetas, ops):
        state = apply_unitary(state, op, theta)
    return state

